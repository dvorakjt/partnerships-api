{
  "name": "partnerships-api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "create-pg-container-config": "npx tsx ./src/scripts/create-pg-container-config.ts",
    "format": "npx prettier . --write",
    "gen-diagram:gql": "npx graphqlviz http://localhost:4000 | dot -Tpng -o src/assets/diagrams/graphql-schema.png",
    "gen-types:db": "npx tsx ./src/scripts/gen-types-db.ts",
    "gen-types:gql": "graphql-codegen --config codegen.config.ts",
    "migrations": "npx tsx ./src/scripts/migrations.ts",
    "pg-dev:start": "npx tsx ./src/scripts/pg.ts --mode=dev start",
    "pg-dev:stop": "npx tsx ./src/scripts/pg.ts --mode=dev stop",
    "pg-test:start": "npx tsx ./src/scripts/pg.ts --mode=test start",
    "pg-test:stop": "npx tsx ./src/scripts/pg.ts --mode=test stop",
    "seed:db": "npx tsx ./src/scripts/seed-db.ts",
    "start": "npx tsx ./src/index.ts",
    "test:db": "npx tsx ./src/scripts/test-db.ts --no-cache"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dvorakjt/partnerships-api.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/dvorakjt/partnerships-api/issues"
  },
  "homepage": "https://github.com/dvorakjt/partnerships-api#readme",
  "devDependencies": {
    "@graphql-codegen/cli": "^6.1.1",
    "@types/content-type": "^1.1.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.0",
    "@types/pg": "^8.16.0",
    "crypto-random-string": "^5.0.0",
    "dbmate": "^2.29.5",
    "graphqlviz": "^4.0.1",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@apollo/server": "^5.4.0",
    "@as-integrations/express5": "^1.1.2",
    "@graphql-tools/load-files": "^7.0.1",
    "@graphql-tools/merge": "^9.1.7",
    "@graphql-tools/utils": "^11.0.0",
    "content-type": "^1.0.5",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "gqlarr": "^0.0.7",
    "graphql": "^16.12.0",
    "graphql-scalars": "^1.25.0",
    "introspeql-kysely": "^0.0.0",
    "json-bigint-patch": "^0.0.9",
    "kysely": "^0.28.15",
    "pg": "^8.18.0",
    "tsx": "^4.21.0",
    "wkx": "^0.5.0"
  }
